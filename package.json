{
  "name": "snapclaim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Measured damage documentation with receipts. Photo + voice in, replayable evidence report out.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "backend:start": "node --experimental-strip-types --no-warnings backend/server.ts",
    "backend:live": "node --experimental-strip-types --no-warnings --env-file=.env backend/server.ts",
    "backend:smoke": "node backend/smoke.mjs",
    "eval": "node --experimental-strip-types --no-warnings eval/bench.ts",
    "replay": "node --experimental-strip-types --no-warnings eval/replay.ts",
    "bench": "node --experimental-strip-types --no-warnings bench/run.ts",
    "bench:archive": "node --experimental-strip-types --no-warnings bench/archive.ts",
    "react:dev": "npm --prefix react run dev",
    "react:build": "npm --prefix react run build",
    "react:preview": "npm --prefix react run preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0"
  }
}
