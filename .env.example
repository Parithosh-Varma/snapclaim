# Copy to .env and fill in locally. Never commit the real .env.
# Mock mode is the default: the demo and CI run at $0 with no keys.
# Set MOCK_MODE=0 to make live calls (needs the keys below).
# MOCK_MODE=0

META_API_KEY=
BASETEN_API_KEY=

META_API_BASE=https://api.meta.ai/v1
BASETEN_API_BASE=https://inference.baseten.co/v1

# Hard cap for live API spend, in USD.
SPEND_GUARD_USD=10

# Optional admin token for the in-app Admin panel's runtime mock/live switch
# (POST /v1/admin/mode). Local dev only: start the server with e.g.
# ADMIN_TOKEN=dev-secret, paste it in the panel, and flip modes without
# restarting. Leave unset to disable runtime switching entirely — and NEVER
# set it on the public Worker.
# ADMIN_TOKEN=

# Comma-separated browser origins allowed to call the API (CORS).
# Unset + mock mode means "*" (local dev, $0 spend). Unset + LIVE mode denies
# browser calls (no ACAO header) so random sites can't spend your cap — set
# this to your PWA origin(s) for local live dev or your Pages URL in production.
# ALLOWED_ORIGINS=https://your-app.pages.dev

# Reference confidence below which the report stays percent-only.
MIN_REFERENCE_CONFIDENCE=0.6
