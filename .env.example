# Copy to .env and fill in locally. Never commit the real .env.
# Mock mode is the default: the demo and CI run at $0 with no keys.
# Set MOCK_MODE=0 to make live calls (needs the keys below).
# MOCK_MODE=0

META_API_KEY=
BASETEN_API_KEY=

META_API_BASE=https://api.meta.ai/v1
BASETEN_API_BASE=https://inference.baseten.co/v1

# Hard cap for live API spend, in USD.
SPEND_GUARD_USD=10

# Comma-separated browser origins allowed to call the API (CORS).
# Unset means "*" (local dev). Set your Pages URL for the public demo
# so random sites can't spend your cap from a web page.
# ALLOWED_ORIGINS=https://your-app.pages.dev

# Reference confidence below which the report stays percent-only.
MIN_REFERENCE_CONFIDENCE=0.6

# Cross-account D1 proxy (no binding needed). The Worker writes donations to
# this database via the Cloudflare API when snapclaim_data is absent.
# D1_PROXY_TOKEN is secret — set with `npx wrangler secret put D1_PROXY_TOKEN`,
# never commit it. D1_PROXY_KEY guards POST /v1/d1/query the same way.
# D1_PROXY_ACCOUNT_ID=18c0b10f1f40932c837b55bc008e78e1
# D1_PROXY_DATABASE_ID=025734a5-ba8b-4e8d-8736-270987c2f181
# D1_PROXY_TOKEN=
# D1_PROXY_KEY=
